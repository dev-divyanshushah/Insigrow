# ========================================================
# Insigrow Industry Solutions Portal - Environment Config
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Session / JWT Secret (change in production)
JWT_SECRET=insigrow_secret_key_prod_2026

# ========================================================
# Transactional Email / SMTP Delivery Configuration
# ========================================================
# Supports any standard SMTP service: SendGrid, Mailgun, AWS SES, Postmark, Brevo, Gmail, etc.
# If these variables are not provided, the server will automatically use Nodemailer Ethereal
# test accounts or safe local simulation in development.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-or-api-key
SMTP_PASS=your-smtp-password-or-secret
SMTP_FROM="Insigrow Enterprise" <welcome@insigrow.com>

# Optional: Specific service shorthand (e.g. gmail)
# SMTP_SERVICE=gmail

